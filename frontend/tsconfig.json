{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false, // Hataları azaltmak için false yaptık
    "noUnusedParameters": false, // Hataları azaltmak için false yaptık
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    
    /* Paths & Base */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "api"], // api klasörünü build'den koruyoruz
  "references": [{ "path": "./tsconfig.node.json" }]
}